# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# Alpaca Markets API credentials
# Get these from: https://alpaca.markets → Paper Trading → API Keys → Generate
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Polygon.io (Massive) API key (optional)
# Get this from: https://polygon.io (now https://massive.com) → Dashboard → API Keys
POLYGON_API_KEY=
